/* Navigation bar */
body{
    margin: 0;
    padding: 0;
}
.nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    
    background-color: #90d3ff;
    padding: 10px 16px;
    font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
}

/* Navigation links */
.nav a {
    color: black;
    text-decoration: none;
    padding: 12px 16px;
    border-radius: 5px;
    font-size: 20px;
}
p{
    font-family: 'Courier New', Courier, monospace;
    font-size: 15px;
}

/* Hover effect */
.nav a:hover {
    background-color: #ddd;
    color: black;
}

/* Mobile layout */
@media (max-width: 600px) {
    .nav {
        flex-direction: column;
        align-items: stretch;
    }

    .nav a {
        text-align: center;
    }
}
